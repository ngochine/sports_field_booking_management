    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                    "const baseUrl = pm.environment.get(\"base_url\");\r",
                    "const requestName = pm.info.requestName;\r",
                    "const field_id = pm.environment.get(\"field_id\")\r",
                    "const id = pm.environment.get(\"booking_id\");\r",
                    "\r",
                    "let BeforeTime = parseInt(pm.environment.get(\"time\"), 10)\r",
                    "\r",
                    "pm.sendRequest({\r",
                    "    url: `${baseUrl}/api/auth/logout`,\r",
                    "    method: \"POST\",\r",
                    "    header: {\r",
                    "        \"Content-Type\": \"application/json\"\r",
                    "    }\r",
                    "});\r",
                    "\r",
                    "\r",
                    "if (requestName === \"TC1 - Không đăng nhập\" || requestName === \"TC6 – Không có quyền\") {\r",
                    "    return;\r",
                    "}\r",
                    "\r",
                    "// if (requestName === \"TC26 – User không có quyền đặt sân\") {\r",
                    "//     pm.sendRequest({\r",
                    "//         url: `${baseUrl}/api/auth/login`,\r",
                    "//         method: \"POST\",\r",
                    "//         header: {\r",
                    "//             \"Content-Type\": \"application/json\"\r",
                    "//         },\r",
                    "//         body: {\r",
                    "//             mode: \"raw\",\r",
                    "//             raw: JSON.stringify({\r",
                    "//                 username:pm.environment.get(\"admin\"),\r",
                    "//                 password:pm.environment.get(\"password_admin\")\r",
                    "//             })\r",
                    "//         }\r",
                    "//     })\r",
                    "//     return;\r",
                    "// }\r",
                    "\r",
                    "function generateBookingTime(hoursFromNow, minutesFromNow = 0) {\r",
                    "    const now = new Date();\r",
                    "    let start = new Date(now);\r",
                    "    start.setHours(start.getHours() + hoursFromNow);\r",
                    "    start.setMinutes(start.getMinutes() + minutesFromNow);\r",
                    "    start.setSeconds(0);\r",
                    "    if (start.getHours() >= 23) {\r",
                    "        start.setDate(start.getDate() + 1);\r",
                    "    }\r",
                    "    const end = new Date(start);\r",
                    "    end.setHours(end.getHours() + 1);\r",
                    "\r",
                    "    return {\r",
                    "        booking_date: start.toISOString().split(\"T\")[0],\r",
                    "        start_time: start.toTimeString().slice(0, 5),\r",
                    "        end_time: end.toTimeString().slice(0, 5)\r",
                    "    };\r",
                    "}\r",
                    "\r",
                    "function setTime(name) {\r",
                    "    if (name.includes(\"Over\")) return generateBookingTime(BeforeTime);\r",
                    "    if (name.includes(\"Equal\")) return generateBookingTime(2, 1);\r",
                    "    if (name.includes(\"Under\")) return generateBookingTime(1, 30);\r",
                    "    return generateBookingTime(3);\r",
                    "}\r",
                    "\r",
                    "\r",
                    "function generateUser() {\r",
                    "    const random = Date.now();\r",
                    "    return {\r",
                    "        username: `user_${random}`,\r",
                    "        password: \"Aa@123456\"\r",
                    "    };\r",
                    "}\r",
                    "\r",
                    "var account = generateUser();\r",
                    "\r",
                    "pm.sendRequest({\r",
                    "    url: `${baseUrl}/api/auth/register`,\r",
                    "    method: \"POST\",\r",
                    "    header: {\r",
                    "        \"Content-Type\": \"application/json\"\r",
                    "    },\r",
                    "    body: {\r",
                    "        mode: \"raw\",\r",
                    "        raw: JSON.stringify({\r",
                    "            username: account.username,\r",
                    "            password: account.password,\r",
                    "            confirm: account.password\r",
                    "        })\r",
                    "    }\r",
                    "}, function (err, res) {\r",
                    "    pm.sendRequest({\r",
                    "        url: `${baseUrl}/api/auth/login`,\r",
                    "        method: \"POST\",\r",
                    "        header: {\r",
                    "            \"Content-Type\": \"application/json\"\r",
                    "        },\r",
                    "        body: {\r",
                    "            mode: \"raw\",\r",
                    "            raw: JSON.stringify({\r",
                    "                username: account.username,\r",
                    "                password: account.password\r",
                    "            })\r",
                    "        }\r",
                    "    }, function (err, res) {\r",
                    "        if (err) {\r",
                    "            return;\r",
                    "        }\r",
                    "        if(requestName.includes(\"Booking\")){\r",
                    "            const timeData = setTime(requestName);\r",
                    "            pm.sendRequest({\r",
                    "                url: `${baseUrl}/api/fields/${field_id}/booking`,\r",
                    "                method: \"POST\",\r",
                    "                header: {\r",
                    "                    \"Content-Type\": \"application/json\"\r",
                    "                },\r",
                    "                body: {\r",
                    "                    mode: \"raw\",\r",
                    "                    raw: JSON.stringify(timeData)\r",
                    "                }\r",
                    "            }, function (err, res) {\r",
                    "                if (err) {\r",
                    "                    pm.environment.set(\"time\", BeforeTime + 1); \r",
                    "                    return;\r",
                    "                }\r",
                    "                const json = res.json();\r",
                    "                if(json.booking?.id){\r",
                    "                    pm.environment.set(\"booking_id\", json.booking?.id);\r",
                    "                }\r",
                    "                pm.environment.set(\"time\", BeforeTime + 1);\r",
                    "            });\r",
                    "        }\r",
                    "    });\r",
                    "});\r",
                    ""
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                    ""
                ]
            }
        }
    ]
