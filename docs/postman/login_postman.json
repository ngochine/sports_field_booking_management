{
    "info": {
        "_postman_id": "af51234a-40fc-4b09-95fb-50b69b7a282e",
        "name": "SPFM - LOGIN",
        "description": "Collection kiểm thử API đăng nhập tài khoản người dùng trong hệ thống quản lý đặt sân thể thao. Mục tiêu nhằm xác minh tính đúng đắn của chức năng đăng nhập thông qua các trường hợp kiểm thử hợp lệ và không hợp lệ, đảm bảo yêu cầu về xác thực thông tin người dùng, phân quyền truy cập, bảo mật tài khoản và khả năng xử lý lỗi của hệ thống.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_exporter_id": "54997124",
        "_collection_link": "https://go.postman.co/collection/50991360-af51234a-40fc-4b09-95fb-50b69b7a282e?source=collection_link"
    },
    "item": [
        {
            "name": "TC1 - Đăng nhập hợp lệ",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {\r",
                            "    pm.response.to.have.status(200);\r",
                            "});\r",
                            "\r",
                            "pm.test(\"Login success\", function () {\r",
                            "    const jsonData = pm.response.json();\r",
                            "    pm.expect(jsonData.success).to.eql(true);\r",
                            "    pm.expect(jsonData.user).to.not.be.null\r",
                            "    pm.expect(jsonData.access_token).to.not.be.null;\r",
                            "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{ \r\n\"username\":\"user02\", \r\n\"password\":\"Aa@123456\" \r\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/auth/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                },
                "description": "Kiểm tra đăng nhập thành công khi nhập đúng username và password đã tồn tại trong hệ thống. API phải xác thực thành công, trả về mã 200, success = true, thông tin người dùng và access token."
            },
            "response": []
        },
